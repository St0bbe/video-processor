GEMINI_API_KEY=sua_nova_chave_aqui
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_ATTEMPTS_PER_MODEL=2
GEMINI_MAX_ATTEMPTS=6
GEMINI_RETRY_BASE_SECONDS=3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_WORD_TIMESTAMPS=false
AI_CHUNK_SECONDS=900
AI_CHUNK_OVERLAP_SECONDS=90
MAX_UPLOAD_MB=4096
MAX_DOWNLOADED_VIDEO_MB=8192
MAX_VIDEO_MINUTES=240
RETENTION_HOURS=48
FFMPEG_PRESET=veryfast
FFMPEG_CRF=20

MIN_FREE_DISK_GB=8
# Legendas queimadas automaticamente nos cortes
BURN_SUBTITLES=true
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=22
SUBTITLE_MARGIN_V=210

# TikTok Login Kit + Content Posting API
# Nunca envie estas credenciais para o navegador ou para o Git.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://cortes.imobiprohub.com/auth/tiktok/callback
